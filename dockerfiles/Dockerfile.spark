FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-21-jre-headless procps curl && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PYSPARK_PYTHON=python3

COPY dockerfiles/requirements-spark.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# JAR'ları build sirasinda indir, runtime'da Maven'a gerek kalmasin
ENV JARS_DIR=/app/jars
RUN mkdir -p ${JARS_DIR}

RUN MAVEN=https://repo1.maven.org/maven2 && \
    curl -fL --retry 5 -o ${JARS_DIR}/delta-spark.jar \
        ${MAVEN}/io/delta/delta-spark_2.12/3.0.0/delta-spark_2.12-3.0.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/delta-storage.jar \
        ${MAVEN}/io/delta/delta-storage/3.0.0/delta-storage-3.0.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/antlr4-runtime.jar \
        ${MAVEN}/org/antlr/antlr4-runtime/4.9.3/antlr4-runtime-4.9.3.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/spark-sql-kafka.jar \
        ${MAVEN}/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.0/spark-sql-kafka-0-10_2.12-3.5.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/spark-token-provider-kafka.jar \
        ${MAVEN}/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.0/spark-token-provider-kafka-0-10_2.12-3.5.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/kafka-clients.jar \
        ${MAVEN}/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/lz4-java.jar \
        ${MAVEN}/org/lz4/lz4-java/1.8.0/lz4-java-1.8.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/snappy-java.jar \
        ${MAVEN}/org/xerial/snappy/snappy-java/1.1.10.5/snappy-java-1.1.10.5.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/slf4j-api.jar \
        ${MAVEN}/org/slf4j/slf4j-api/2.0.7/slf4j-api-2.0.7.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/hadoop-client-runtime.jar \
        ${MAVEN}/org/apache/hadoop/hadoop-client-runtime/3.3.4/hadoop-client-runtime-3.3.4.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/hadoop-client-api.jar \
        ${MAVEN}/org/apache/hadoop/hadoop-client-api/3.3.4/hadoop-client-api-3.3.4.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/commons-logging.jar \
        ${MAVEN}/commons-logging/commons-logging/1.1.3/commons-logging-1.1.3.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/jsr305.jar \
        ${MAVEN}/com/google/code/findbugs/jsr305/3.0.0/jsr305-3.0.0.jar && \
    curl -fL --retry 5 -o ${JARS_DIR}/commons-pool2.jar \
        ${MAVEN}/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar

WORKDIR /app

COPY spark/ ./spark/
COPY notebooks/ ./notebooks/

CMD ["sleep", "infinity"]
